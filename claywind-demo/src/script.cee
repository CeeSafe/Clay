// SPDX-License-Identifier: MIT
// A scripted, deterministic platform for screenshots and tests: the same input grammar and clock as the C build's
// headless screenshot tool (~/dev/ClayWind/tests/demo_shot), so both sides see identical frames.
//
//   "FRAME:click:X,Y;FRAME:right:X,Y;FRAME:move:X,Y;FRAME:key:NAME;FRAME:type:TEXT"
//
// A click presses the button on FRAME and releases it on the next frame. NAME is tab, enter, up, down, left,
// right, backspace, or one letter (which arrives as a typed character, as letter keys do in ClayWind). Every frame is
// exactly 1/60 s and the clock is frames / 60.

import claywind;

/// The script platform. It keeps its own copy of the script (up to 4 KB), since a platform used as a `dyn
/// Platform` cannot hold a loan.
public struct ScriptPlatform {
    script: [u8; 4096];
    scriptLength: usize;
    size: Dims;
    frame: u32;
    pointerState: Pointer;
    releaseNext: u8;
    pressedKey: u32;
    typed: [u32; 64];
    typedCount: usize;
    typedRead: usize;
    public cursor: Cursor;

    public fn create(script: Slice<u8>, size: Dims) -> ScriptPlatform {
        var p = ScriptPlatform {
            script: [0u8; 4096],
            scriptLength: if (script.length < 4096) script.length else 4096,
            size: size,
            frame: 0,
            pointerState: Pointer.at(Vec2 { x: -100.0, y: -100.0 }),
            releaseNext: 0,
            pressedKey: 0,
            typed: [0u32; 64],
            typedCount: 0,
            typedRead: 0,
            cursor: Cursor.Default,
        };
        for (i in 0..p.scriptLength) {
            p.script[i] = script[i];
        }
        return p;
    }

    /// The frame about to run (0-based).
    public fn frameIndex(borrow this) -> u32 => this.frame;

    /// Applies frame `frameIndex()`'s events; call before `ui.begin`.
    public fn beginFrame(borrow mut this) {
        this.pointerState.pressed = false;
        this.pointerState.released = false;
        this.pointerState.secondaryPressed = false;
        this.pressedKey = 0;
        this.typedCount = 0;
        this.typedRead = 0;
        if (this.releaseNext == 1) {
            this.pointerState.down = false;
            this.pointerState.released = true;
        }
        if (this.releaseNext == 2) {
            this.pointerState.secondaryDown = false;
        }
        this.releaseNext = 0;
        let script = this.script;
        let s = script[0..this.scriptLength];
        var start: usize = 0;
        for (k in 0..s.length + 1) {
            if (k == s.length || s[k] == ';') {
                this.event(s[start..k]);
                start = k + 1;
            }
        }
    }

    /// Advances the clock; call after the frame.
    public fn endFrame(borrow mut this) {
        this.frame += 1;
    }

    fn event(borrow mut this, e: Slice<u8>) {
        // FRAME:KIND:ARG
        var first: usize = 0;
        while (first < e.length && e[first] != ':') {
            first += 1;
        }
        if (first >= e.length || parseUnsigned(e[0..first]) != this.frame as u64) {
            return;
        }
        var second = first + 1;
        while (second < e.length && e[second] != ':') {
            second += 1;
        }
        if (second >= e.length) {
            return;
        }
        let kind = e[first + 1..second];
        let arg = e[second + 1..];
        if (same(kind, "move") || same(kind, "click") || same(kind, "right")) {
            var comma: usize = 0;
            while (comma < arg.length && arg[comma] != ',') {
                comma += 1;
            }
            let x = parseDecimal(arg[0..comma]);
            let y = if (comma < arg.length) parseDecimal(arg[comma + 1..]) else 0.0;
            this.pointerState.position = Vec2 { x: x, y: y };
            if (same(kind, "click")) {
                this.pointerState.down = true;
                this.pointerState.pressed = true;
                this.releaseNext = 1;
            } else if (same(kind, "right")) {
                this.pointerState.secondaryDown = true;
                this.pointerState.secondaryPressed = true;
                this.releaseNext = 2;
            }
        } else if (same(kind, "key")) {
            if (arg.length == 1) {
                this.push(arg[0] as u32);
            } else {
                this.pressedKey = namedKey(arg);
            }
        } else if (same(kind, "type")) {
            for (i in 0..arg.length) {
                this.push(arg[i] as u32);
            }
        }
    }

    fn push(borrow mut this, c: u32) {
        if (this.typedCount < 64) {
            this.typed[this.typedCount] = c;
            this.typedCount += 1;
        }
    }
}

impl Platform for ScriptPlatform {
    fn screenSize(borrow this) -> Dims => this.size;
    fn frameTime(borrow this) -> f32 => 1.0 / 60.0;
    fn time(borrow this) -> f64 => round<f64>(this.frame) / 60.0;
    fn pointer(borrow this) -> Pointer => this.pointerState;
    fn keyDown(borrow this, key: Key) -> bool => this.pressedKey == keyIndex(key) + 1;
    fn keyPressed(borrow this, key: Key) -> bool => this.pressedKey == keyIndex(key) + 1;
    fn keyRepeated(borrow this, key: Key) -> bool => false;
    fn nextChar(borrow mut this) -> u32 {
        if (this.typedRead >= this.typedCount) {
            return 0;
        }
        let c = this.typed[this.typedRead];
        this.typedRead += 1;
        return c;
    }
    fn setCursor(borrow mut this, cursor: Cursor) {
        this.cursor = cursor;
    }
}

/// keyIndex + 1 of a named key, 0 for none.
fn namedKey(name: Slice<u8>) -> u32 {
    let k: Key? = if (same(
        name,
        "tab",
    )) Key.Tab else if (same(
        name,
        "enter",
    )) Key.Enter else if (same(
        name,
        "up",
    )) Key.Up else if (same(
        name,
        "down",
    )) Key.Down else if (same(
        name,
        "left",
    )) Key.Left else if (same(name, "right")) Key.Right else if (same(name, "backspace")) Key.Backspace else null;
    return match (k) {
        Some(key) => keyIndex(key) + 1,
        null => 0,
    };
}

fn same(a: Slice<u8>, b: StringView) -> bool {
    let bb = b.bytes();
    if (a.length != bb.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != bb[i]) {
            return false;
        }
    }
    return true;
}

/// A non-negative decimal integer (u64::MAX when it is not one).
public fn parseUnsigned(s: Slice<u8>) -> u64 {
    if (s.length == 0) {
        return 0xFFFFFFFFFFFFFFFF;
    }
    var v: u64 = 0;
    for (i in 0..s.length) {
        if (s[i] < '0' || s[i] > '9') {
            return 0xFFFFFFFFFFFFFFFF;
        }
        v = v * 10 + ((s[i] - '0') as u64);
    }
    return v;
}

/// A decimal number such as 12, -3 or 40.5.
public fn parseDecimal(s: Slice<u8>) -> f32 {
    var i: usize = 0;
    var negative = false;
    if (i < s.length && s[i] == '-') {
        negative = true;
        i += 1;
    }
    var value: f64 = 0.0;
    while (i < s.length && s[i] >= '0' && s[i] <= '9') {
        value = value * 10.0 + round<f64>((s[i] - '0') as u32);
        i += 1;
    }
    if (i < s.length && s[i] == '.') {
        i += 1;
        var scale: f64 = 0.1;
        while (i < s.length && s[i] >= '0' && s[i] <= '9') {
            value += round<f64>((s[i] - '0') as u32) * scale;
            scale *= 0.1;
            i += 1;
        }
    }
    let v = round<f32>(value);
    return if (negative) -v else v;
}
