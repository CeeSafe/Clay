// SPDX-License-Identifier: MIT
// Interactive controls, ported from controls.h: immediate-mode functions you call every frame. Each draws itself with
// the style layer, reads and writes CALLER-OWNED state passed by reference, consumes input, and returns whether it
// changed. No hidden allocation and no per-widget retained store: you own the text buffer, the bool, the selected
// index, the open flag. A control's sub-elements get ids derived from its id ("save~3", "qty~inc" in C).
//
// Differences from C, all forced by the language and none visible: ids are hashed when built (no string formatting
// into fixed char buffers), text buffers are byte slices with a separate length (no NUL terminator), and the one
// control that measures text while it is declared (`textInputEx`, for its caret) takes the text metrics as an
// argument, since the Ui does not hold them between frames.

/// The id of sub-element `suffix`/`index` of control `base` (C: snprintf("%s~%d") / "%s~pop").
fn subId(base: StringView, suffix: StringView, index: i64) -> u32 {
    var buffer = [0u8; 96];
    var w = TextWriter.create(mut buffer[..]);
    w.text(base);
    w.byte('~');
    w.text(suffix);
    if (index >= 0) {
        w.signed(index);
    }
    return hashBytes(w.written());
}

/// How many items a '|'-separated item list holds ("Small|Medium|Large" holds 3; "" holds 0). C passes
/// `const char **`; a slice of views is not allowed, so item lists are one view.
public fn itemCount(items: StringView) -> usize {
    if (items.length == 0) {
        return 0;
    }
    let b = items.bytes();
    var n: usize = 1;
    for (k in 0..b.length) {
        if (b[k] == '|') {
            n += 1;
        }
    }
    return n;
}

/// Item `index` of a '|'-separated item list (empty past the end).
public fn itemAt<region r>(items: StringView<r>, index: usize) -> StringView<r> {
    let b = items.bytes();
    var start: usize = 0;
    var seen: usize = 0;
    for (k in 0..b.length) {
        if (b[k] == '|') {
            if (seen == index) {
                return items[start..k];
            }
            seen += 1;
            start = k + 1;
        }
    }
    if (seen == index) {
        return items[start..];
    }
    return items[0..0];
}

/// The controls (controls.h's ClayWind_* functions).
public struct Controls {
    /// ClayWind_Button: true on the frame it is clicked.
    public fn button(ui: borrow mut Ui, id: StringView, label: StringView) -> bool {
        let h = hashId(id);
        ui.open(
            Style.box().idHash(h).px(space(4.0)).py(space(2.0)).bg(SLATE_700).rounded(Radius.Md).cursor(Cursor.Pointer)
                .hover(Style.of().bg(SLATE_600)).active(Style.of().bg(SLATE_500)),
        );
        let hit = ui.pressedOn(h);
        ui.label(label, Text.of().color(SLATE_100));
        ui.close();
        return hit;
    }

    /// ClayWind_Checkbox: toggles `value` when clicked.
    public fn checkbox(ui: borrow mut Ui, id: StringView, label: StringView, value: borrow mut bool) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(
            Style.row().idHash(h).gap(space(2.0)).alignXY(AxisAlign.Start, AxisAlign.Center).cursor(Cursor.Pointer),
        );
        if (ui.pressedOn(h)) {
            value = !value;
            changed = true;
        }
        ui.open(Style.box().size(Size.fixed(18.0)).bg(if (value) BLUE_500 else SLATE_700).rounded(Radius.Sm).center()
            .border(1.0, SLATE_500));
        if (value) {
            ui.open(Style.box().size(Size.fixed(14.0)).icon(ICON_CHECK, WHITE, 0.0));
            ui.close();
        }
        ui.close();
        ui.label(label, Text.of().color(SLATE_200));
        ui.close();
        return changed;
    }

    /// The text field's shared frame style (minH keeps it one line tall while empty).
    fn fieldStyle(h: u32, focused: bool) -> Style => Style.box().idHash(h).w(Size.grow()).px(space(3.0)).py(space(2.0))
        .minH(18.0 + 2.0 * space(2.0)).bg(SLATE_800).rounded(Radius.Md).cursor(Cursor.Text).isFocused(focused)
        .border(1.0, SLATE_600).focus(Style.of().border(2.0, BLUE_400));

    /// ClayWind_TextInput: edits at the end (type, Backspace); Enter leaves the field.
    public fn textInput(ui: borrow mut Ui, id: StringView, buf: SliceMut<u8>, len: borrow mut usize) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h);
        let focused = ui.hasFocus(h);
        var changed = false;
        ui.open(Controls.fieldStyle(h, focused));
        if (ui.pressedOn(h)) {
            ui.setFocus(h);
        }
        if (focused) {
            loop {
                let c = ui.nextChar();
                if (c == 0) {
                    break;
                }
                if (c >= 32 && c < 127 && len < buf.length) {
                    buf[len] = truncate<u8>(c);
                    len += 1;
                    changed = true;
                }
            }
            if (ui.keyHit(Key.Backspace) && len > 0) {
                len -= 1;
                changed = true;
            }
            if (ui.keyPressed(Key.Enter)) {
                ui.clearFocus();
            }
        }
        ui.open(Style.row().alignXY(AxisAlign.Start, AxisAlign.Center));
        if (len > 0) {
            ui.labelBytes(buf[0..len], Text.of().color(SLATE_100));
        }
        // A blinking caret at the end (about 2 Hz) while focused.
        if (focused && (truncate<u64>((ui.time() * 2.0).floor()) & 1) == 0) {
            ui.open(Style.box().w(Size.fixed(2.0)).h(Size.fixed(18.0)).bg(SLATE_200));
            ui.close();
        }
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_Dropdown: a trigger showing `itemAt(items, selected)`; when `open`, a floating list (click outside closes).
    public fn dropdown(
        ui: borrow mut Ui,
        id: StringView,
        items: StringView,
        selected: borrow mut usize,
        open: borrow mut bool,
    ) -> bool {
        let h = hashId(id);
        let pop = subId(id, "pop", -1);
        var changed = false;
        ui.open(Style.box().idHash(h).w(Size.grow()).px(space(3.0)).py(space(2.0)).bg(SLATE_800).rounded(Radius.Md)
            .cursor(Cursor.Pointer).border(1.0, SLATE_600).hover(Style.of().bg(SLATE_700)));
        if (ui.pressedOn(h)) {
            open = !open;
        }
        ui.open(Style.row().w(Size.grow()).alignXY(AxisAlign.Start, AxisAlign.Center));
        if (selected < itemCount(items)) {
            ui.label(itemAt(items, selected), Text.of().color(SLATE_100));
        }
        ui.open(Style.box().w(Size.grow()));
        ui.close();
        ui.open(Style.box().size(Size.fixed(14.0)).icon(ICON_CHEVRON_DOWN, SLATE_400, 0.0));
        ui.close();
        ui.close();
        if (open) {
            // A floating list below the trigger, layered above everything.
            ui.open(Style.box().idHash(pop).absolute().top(38.0).z(200).w(Size.fixed(200.0)).h(Size.fit()).maxH(220.0)
                .bg(SLATE_900).rounded(Radius.Md).border(1.0, SLATE_600).scroll(ScrollAxis.Vertical).p(space(1.0)));
            ui.open(Style.column().w(Size.grow()).gap(space(1.0)));
            for (i in 0..itemCount(items)) {
                let row = subId(id, "", truncate<i64>(i));
                let isSelected = i == selected;
                var style = Style.box().idHash(row).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm)
                    .cursor(Cursor.Pointer).bg(if (isSelected) BLUE_600 else NONE);
                if (!isSelected) {
                    style = style.hover(Style.of().bg(SLATE_700));
                }
                ui.open(style);
                if (ui.pressedOn(row)) {
                    selected = i;
                    open = false;
                    changed = true;
                }
                ui.label(itemAt(items, i), Text.of().color(SLATE_100));
                ui.close();
            }
            ui.close();
            ui.close();
        }
        ui.close();
        // A click anywhere outside the trigger or the list closes it.
        if (open && ui.pressedOutside(h, pop)) {
            open = false;
        }
        return changed;
    }

    /// ClayWind_Listbox: a scrolling single-selection list `height` tall.
    public fn listbox(
        ui: borrow mut Ui,
        id: StringView,
        items: StringView,
        selected: borrow mut usize,
        height: SizingAxis,
    ) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(
            Style.box().idHash(h).w(Size.grow()).h(height).bg(SLATE_800).rounded(Radius.Md).scroll(ScrollAxis.Vertical)
                .border(1.0, SLATE_600).p(space(1.0)),
        );
        ui.open(Style.column().w(Size.grow()).gap(space(1.0)));
        for (i in 0..itemCount(items)) {
            let row = subId(id, "", truncate<i64>(i));
            let isSelected = i == selected;
            var style = Style.box().idHash(row).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm)
                .cursor(Cursor.Pointer).bg(if (isSelected) BLUE_600 else NONE);
            if (!isSelected) {
                style = style.hover(Style.of().bg(SLATE_700));
            }
            ui.open(style);
            if (ui.pressedOn(row)) {
                selected = i;
                changed = true;
            }
            ui.label(itemAt(items, i), Text.of().color(if (isSelected) WHITE else SLATE_200));
            ui.close();
        }
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_ListboxMulti: each row toggles its own `selected[i]`.
    public fn listboxMulti(
        ui: borrow mut Ui,
        id: StringView,
        items: StringView,
        selected: SliceMut<bool>,
        height: SizingAxis,
    ) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(
            Style.box().idHash(h).w(Size.grow()).h(height).bg(SLATE_800).rounded(Radius.Md).scroll(ScrollAxis.Vertical)
                .border(1.0, SLATE_600).p(space(1.0)),
        );
        ui.open(Style.column().w(Size.grow()).gap(space(1.0)));
        for (i in 0..itemCount(items)) {
            let row = subId(id, "", truncate<i64>(i));
            let on = i < selected.length && selected[i];
            var style = Style.box().idHash(row).w(Size.grow()).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm)
                .cursor(Cursor.Pointer).bg(if (on) BLUE_600 else NONE);
            if (!on) {
                style = style.hover(Style.of().bg(SLATE_700));
            }
            ui.open(style);
            if (ui.pressedOn(row) && i < selected.length) {
                selected[i] = !selected[i];
                changed = true;
            }
            let nowOn = i < selected.length && selected[i];
            ui.label(itemAt(items, i), Text.of().color(if (nowOn) WHITE else SLATE_200));
            ui.close();
        }
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_Slider: press on the track to capture; the value follows the pointer until release.
    public fn slider(ui: borrow mut Ui, id: StringView, value: borrow mut f32, min: f32, max: f32, width: f32) -> bool {
        let h = hashId(id);
        var changed = false;
        let track = ui.boxOfHash(h); // the previous frame's track
        let p = ui.pointer();
        if (p.pressed && ui.overHash(h)) {
            ui.capture(h);
        }
        if (p.released && ui.captured() == h) {
            ui.capture(0);
        }
        match (track) {
            Some(bb) => {
                if (ui.captured() == h && p.down && bb.w > 0.0) {
                    let t = Math.clamp((p.position.x - bb.x) / bb.w, 0.0, 1.0);
                    let next = min + t * (max - min);
                    if (next != value) {
                        value = next;
                        changed = true;
                    }
                }
            }
            null => {}
        }
        let frac = if (max > min) Math.clamp((value - min) / (max - min), 0.0, 1.0) else 0.0;
        ui.open(
            Style.box().idHash(h).w(
                Size.fixed(width),
            ).h(Size.fixed(16.0)).bg(SLATE_700).rounded(Radius.Xl).cursor(Cursor.Pointer),
        );
        ui.open(Style.box().w(Size.fixed(frac * width)).h(Size.grow()).bg(BLUE_500).rounded(Radius.Xl));
        ui.close();
        ui.close();
        return changed;
    }

    /// ClayWind_Radio: one of `items`.
    public fn radio(ui: borrow mut Ui, id: StringView, items: StringView, selected: borrow mut usize) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(Style.column().idHash(h).gap(space(2.0)));
        for (i in 0..itemCount(items)) {
            let row = subId(id, "", truncate<i64>(i));
            ui.open(
                Style.row().idHash(row).gap(space(2.0)).alignXY(
                    AxisAlign.Start,
                    AxisAlign.Center,
                ).cursor(Cursor.Pointer),
            );
            if (ui.pressedOn(row)) {
                selected = i;
                changed = true;
            }
            ui.open(Style.box().size(Size.fixed(18.0)).rounded(Radius.Xl).center().border(2.0, SLATE_500));
            if (i == selected) {
                ui.open(Style.box().size(Size.fixed(8.0)).bg(BLUE_500).rounded(Radius.Xl));
                ui.close();
            }
            ui.close();
            ui.label(itemAt(items, i), Text.of().color(SLATE_200));
            ui.close();
        }
        ui.close();
        return changed;
    }

    /// ClayWind_Tabs: a row of tabs; `active` is the open one.
    public fn tabs(ui: borrow mut Ui, id: StringView, items: StringView, active: borrow mut usize) -> bool {
        let h = hashId(id);
        var changed = false;
        ui.open(Style.row().idHash(h).gap(space(1.0)));
        for (i in 0..itemCount(items)) {
            let tab = subId(id, "", truncate<i64>(i));
            let on = i == active;
            var style = Style.box().idHash(tab).px(space(3.0)).py(space(2.0)).roundedT(Radius.Md).cursor(Cursor.Pointer)
                .bg(if (on) SLATE_700 else NONE);
            if (!on) {
                style = style.hover(Style.of().bg(SLATE_800));
            }
            ui.open(style);
            if (ui.pressedOn(tab)) {
                active = i;
                changed = true;
            }
            ui.label(itemAt(items, i), Text.of().color(if (on) SLATE_100 else SLATE_400));
            ui.close();
        }
        ui.close();
        return changed;
    }

    /// ClayWind_ContextMenu: while `open`, a menu fixed to the window at (x, y); returns the chosen index, else null.
    /// (The caller opens it, typically on a secondary press: `ui.secondaryPressedOn(id)`.)
    public fn contextMenu(
        ui: borrow mut Ui,
        id: StringView,
        items: StringView,
        open: borrow mut bool,
        x: f32,
        y: f32,
    ) -> usize? {
        if (!open) {
            return null;
        }
        let h = hashId(id);
        var chosen: usize? = null;
        ui.open(Style.box().idHash(h).fixed().left(x).top(y).z(300).bg(SLATE_900).p(space(1.0)).rounded(Radius.Md)
            .border(1.0, SLATE_600));
        ui.open(Style.column().w(Size.fixed(180.0)));
        for (i in 0..itemCount(items)) {
            let row = subId(id, "", truncate<i64>(i));
            ui.open(
                Style.box().idHash(row).w(
                    Size.grow(),
                ).px(space(3.0)).py(space(2.0)).rounded(Radius.Sm).cursor(Cursor.Pointer)
                    .hover(Style.of().bg(BLUE_600)),
            );
            if (ui.pressedOn(row)) {
                chosen = i;
                open = false;
            }
            ui.label(itemAt(items, i), Text.of().color(SLATE_100));
            ui.close();
        }
        ui.close();
        ui.close();
        if (open && ui.pressedOutside(h, 0)) {
            open = false;
        }
        return chosen;
    }

    /// ClayWind_Tooltip: a floating tip beside the pointer while `targetId` is hovered.
    public fn tooltip(ui: borrow mut Ui, targetId: StringView, text: StringView) {
        if (!ui.overHash(hashId(targetId))) {
            return;
        }
        let m = ui.pointer().position;
        ui.open(Style.box().id("cw-tip").fixed().left(m.x + 14.0).top(m.y + 16.0).z(400).px(space(2.0)).py(space(1.0))
            .bg(SLATE_950).rounded(Radius.Sm).border(1.0, SLATE_600));
        ui.label(text, Text.of().color(SLATE_100));
        ui.close();
    }

    /// ClayWind_SpinInput: -/value/+ buttons, and Up/Down while focused, within [min, max] by `step`.
    public fn spinInput(
        ui: borrow mut Ui,
        id: StringView,
        value: borrow mut i32,
        min: i32,
        max: i32,
        step: i32,
    ) -> bool {
        let h = hashId(id);
        ui.registerFocusable(h);
        let focused = ui.hasFocus(h);
        var changed = false;
        let dec = subId(id, "dec", -1);
        let inc = subId(id, "inc", -1);
        ui.open(Style.row().idHash(h).gap(space(1.0)).alignXY(AxisAlign.Start, AxisAlign.Center).p(space(1.0))
            .rounded(Radius.Md).isFocused(focused).border(1.0, SLATE_600).focus(Style.of().border(2.0, BLUE_400)));
        if (ui.pressedOn(h)) {
            ui.setFocus(h);
        }
        ui.open(
            Style.box().idHash(dec).size(
                Size.fixed(22.0),
            ).bg(SLATE_700).rounded(Radius.Sm).cursor(Cursor.Pointer).center()
                .icon(ICON_MINUS, SLATE_100, 0.0).hover(Style.of().bg(SLATE_600)),
        );
        if (ui.pressedOn(dec) && value - step >= min) {
            value -= step;
            changed = true;
        }
        ui.close();
        ui.open(Style.box().w(Size.fixed(44.0)).h(Size.fixed(22.0)).center());
        var digits = [0u8; 24];
        var w = TextWriter.create(mut digits[..]);
        w.signed(value as i64);
        ui.labelBytes(w.written(), Text.of().color(SLATE_100));
        ui.close();
        ui.open(
            Style.box().idHash(inc).size(
                Size.fixed(22.0),
            ).bg(SLATE_700).rounded(Radius.Sm).cursor(Cursor.Pointer).center()
                .icon(ICON_PLUS, SLATE_100, 0.0).hover(Style.of().bg(SLATE_600)),
        );
        if (ui.pressedOn(inc) && value + step <= max) {
            value += step;
            changed = true;
        }
        ui.close();
        ui.close();
        if (focused) {
            if (ui.keyHit(Key.Up) && value + step <= max) {
                value += step;
                changed = true;
            }
            if (ui.keyHit(Key.Down) && value - step >= min) {
                value -= step;
                changed = true;
            }
        }
        return changed;
    }
}

/// ClayWind_TextInputEx: a text field with a caller-owned caret (Left/Right/Home/End move it, Backspace/Delete and
/// typing edit at it). It measures the text before the caret to place it, so it takes the text metrics.
public fn textInputEx<M: TextMetrics>(
    ui: borrow mut Ui,
    metrics: borrow M,
    id: StringView,
    buf: SliceMut<u8>,
    len: borrow mut usize,
    caret: borrow mut usize,
) -> bool {
    let h = hashId(id);
    ui.registerFocusable(h);
    let focused = ui.hasFocus(h);
    var changed = false;
    if (caret > len) {
        caret = len;
    }
    ui.open(Controls.fieldStyle(h, focused));
    if (ui.pressedOn(h)) {
        ui.setFocus(h);
    }
    if (focused) {
        loop {
            let c = ui.nextChar();
            if (c == 0) {
                break;
            }
            if (c >= 32 && c < 127 && len < buf.length) {
                // Shift the tail right by one and insert at the caret.
                var k: usize = len + 0;
                while (k > caret) {
                    buf[k] = buf[k - 1];
                    k -= 1;
                }
                buf[caret] = truncate<u8>(c);
                caret += 1;
                len += 1;
                changed = true;
            }
        }
        if (ui.keyHit(Key.Backspace) && caret > 0) {
            for (k in caret..len) {
                buf[k - 1] = buf[k];
            }
            caret -= 1;
            len -= 1;
            changed = true;
        }
        if (ui.keyHit(Key.Delete) && caret < len) {
            for (k in caret + 1..len) {
                buf[k - 1] = buf[k];
            }
            len -= 1;
            changed = true;
        }
        if (ui.keyHit(Key.Left) && caret > 0) {
            caret -= 1;
        }
        if (ui.keyHit(Key.Right) && caret < len) {
            caret += 1;
        }
        if (ui.keyPressed(Key.Home)) {
            caret = 0;
        }
        if (ui.keyPressed(Key.End)) {
            caret = len;
        }
        if (ui.keyPressed(Key.Enter)) {
            ui.clearFocus();
        }
    }
    if (len > 0) {
        ui.labelBytes(buf[0..len], Text.of().color(SLATE_100));
    }
    // The caret, absolutely placed at the measured width of buf[0..caret), past the padding.
    if (focused && (truncate<u64>((ui.time() * 2.0).floor()) & 1) == 0) {
        let cx = metrics.measure(buf[0..caret], TextConfig.of(18.0)).w;
        ui.open(
            Style.box().absolute().left(
                space(3.0) + cx,
            ).top(space(2.0)).w(Size.fixed(2.0)).h(Size.fixed(18.0)).bg(SLATE_200),
        );
        ui.close();
    }
    ui.close();
    return changed;
}
