// Sizing along an axis (Clay__SizeContainersAlongAxis) and its flex-wrap helpers, ported from the ClayWind fork.

/// One wrapped line: children [start, end) (Clay__WrapLine). Sizes include margins, mainSize the in-line gaps.
struct WrapLine {
    end: usize;
    count: usize;
    mainSize: f32;
    crossSize: f32;
}

/// All of a wrapping container's lines and how align-content spreads them (Clay__WrapLines).
struct WrapLines {
    lineCount: usize;
    longestLine: f32;
    linesCross: f32;
    lead: f32;
    between: f32;
    stretch: f32;
}

const EPSILON: f32 = 0.01;

/// Clay__NextWrapLine: the line starting at child `start`, breaking before the child that would overflow.
fn nextWrapLine(l: borrow LayoutTree, parent: usize, start: usize, hinted: bool) -> WrapLine {
    let p = l.nodes.items[parent];
    let layout = p.decl.layout;
    let row = layout.isRow();
    let useHints = hinted && l.useHeightHints;
    let parentHeight = if (useHints) p.hintHeight else p.dims.h;
    let innerMain =
        if (row) p.dims.w -
            layout.padding.left - layout.padding.right else parentHeight - layout.padding.top - layout.padding.bottom;
    var line = WrapLine { end: start, count: 0, mainSize: 0.0, crossSize: 0.0 };
    var i = start;
    while (i < p.childCount) {
        let child = childOf(l, parent, i);
        let c = l.nodes.items[child];
        let m = marginOf(l, child);
        let childHeight = if (useHints) c.hintHeight else c.dims.h;
        let childMain = if (row) c.dims.w + m.left + m.right else childHeight + m.top + m.bottom;
        let childCross = if (row) childHeight + m.top + m.bottom else c.dims.w + m.left + m.right;
        let advance = (if (line.count > 0) layout.childGap else 0.0) + childMain;
        if (line.count > 0 && line.mainSize + advance > innerMain + EPSILON) {
            break;
        }
        line.mainSize += advance;
        line.crossSize = line.crossSize.max(childCross);
        line.count += 1;
        line.end = i + 1;
        i += 1;
    }
    return line;
}

/// Clay__MeasureWrapLines.
fn measureWrapLines(l: borrow LayoutTree, parent: usize, hinted: bool) -> WrapLines {
    let p = l.nodes.items[parent];
    let layout = p.decl.layout;
    var lines = WrapLines { lineCount: 0, longestLine: 0.0, linesCross: 0.0, lead: 0.0, between: 0.0, stretch: 0.0 };
    var start: usize = 0;
    while (start < p.childCount) {
        let line = nextWrapLine(l, parent, start, hinted);
        lines.longestLine = lines.longestLine.max(line.mainSize);
        lines.linesCross += line.crossSize;
        lines.lineCount += 1;
        start = line.end;
    }
    if (lines.lineCount == 0) {
        return lines;
    }
    lines.linesCross += usizeF(lines.lineCount - 1) * layout.childGapCross;
    let row = layout.isRow();
    let parentHeight = if (hinted && l.useHeightHints) p.hintHeight else p.dims.h;
    let innerCross =
        if (row) parentHeight -
            layout.padding.top - layout.padding.bottom else p.dims.w - layout.padding.left - layout.padding.right;
    let free = innerCross - lines.linesCross;
    var mode = layout.alignContent;
    // As in CSS: with no room left, between/stretch fall back to start and around/evenly to center.
    if (free < 0.0) {
        mode = match (mode) {
            AlignContent.Between => AlignContent.Start,
            AlignContent.Stretch => AlignContent.Start,
            AlignContent.Around => AlignContent.Center,
            AlignContent.Evenly => AlignContent.Center,
            _ => mode,
        };
    }
    let count = usizeF(lines.lineCount);
    match (mode) {
        AlignContent.Center => { lines.lead = free / 2.0; }
        AlignContent.End => { lines.lead = free; }
        AlignContent.Between => { lines.between = if (lines.lineCount > 1) free / (count - 1.0) else 0.0; }
        AlignContent.Around => {
            lines.between = free / count;
            lines.lead = lines.between / 2.0;
        }
        AlignContent.Evenly => {
            lines.between = free / (count + 1.0);
            lines.lead = lines.between;
        }
        AlignContent.Stretch => { lines.stretch = free / count; }
        AlignContent.Start => {}
    }
    return lines;
}

/// Clay__WrapLineSignature: a fingerprint of where the lines break.
fn wrapLineSignature(l: borrow LayoutTree, parent: usize, hinted: bool) -> u32 {
    var signature: u32 = 2166136261;
    var start: usize = 0;
    let count = l.nodes.items[parent].childCount;
    while (start < count) {
        start = nextWrapLine(l, parent, start, hinted).end;
        signature = (signature ^ truncate<u32>(start)).wrappingMul(16777619);
    }
    return signature;
}

/// Clay__StretchedLineCross: a stretched line's final cross size after its GROW/stretch children grew.
fn stretchedLineCross(l: borrow LayoutTree, parent: usize, start: usize, end: usize, stretch: f32) -> f32 {
    let p = l.nodes.items[parent];
    let row = p.decl.layout.isRow();
    var naturalOthers: f32 = 0.0;
    var grown: f32 = 0.0;
    for (i in start..end) {
        let child = childOf(l, parent, i);
        let c = l.nodes.items[child];
        let m = marginOf(l, child);
        let cross = if (row) c.dims.h + m.top + m.bottom else c.dims.w + m.left + m.right;
        let sizing = sizingOf(l, child, !row);
        let stretched = !c.isText && (sizing.isGrow() || (p.decl.layout.stretch && sizing.isFit()));
        if (stretched) {
            grown = grown.max(cross);
        } else {
            naturalOthers = naturalOthers.max(cross);
        }
    }
    return (naturalOthers + stretch).max(grown);
}

fn sizeOf(l: borrow LayoutTree, index: usize, xAxis: bool) -> f32 =>
    if (xAxis) l.nodes.items[index].dims.w else l.nodes.items[index].dims.h;

fn setSize(l: borrow mut LayoutTree, index: usize, xAxis: bool, value: f32) {
    if (xAxis) {
        l.nodes.items[index].dims.w = value;
    } else {
        l.nodes.items[index].dims.h = value;
    }
}

fn minOf(l: borrow LayoutTree, index: usize, xAxis: bool) -> f32 =>
    if (xAxis) l.nodes.items[index].minDims.w else l.nodes.items[index].minDims.h;

/// Removes entry `k` of the scratch list by swapping the last one in (Clay's RemoveSwapback).
fn removeSwapback(l: borrow mut LayoutTree, k: usize) {
    let last = l.scratch.length() - 1;
    l.scratch.items[k] = l.scratch.items[last];
    l.scratch.pop();
}

/// Clay__GrowAdditive: CSS flex-grow over the scratch list, equal shares from each base size up to its max.
fn growAdditive(l: borrow mut LayoutTree, freeSpace: f32, xAxis: bool) {
    var free = freeSpace;
    while (free > EPSILON && l.scratch.length() > 0) {
        let share = free / usizeF(l.scratch.length());
        let before = free;
        var k: usize = 0;
        while (k < l.scratch.length()) {
            let child = l.scratch.items[k];
            let maxSize = sizingOf(l, child, xAxis).max;
            let previous = sizeOf(l, child, xAxis);
            let size = (previous + share).min(maxSize);
            setSize(mut l, child, xAxis, size);
            free -= size - previous;
            if (size >= maxSize - EPSILON) {
                removeSwapback(mut l, k);
            } else {
                k += 1;
            }
        }
        if (before - free < EPSILON) {
            break;
        }
    }
}

/// Clay__ShrinkWeighted: CSS flex-shrink over the scratch list, in proportion to base size, down to each minimum.
fn shrinkWeighted(l: borrow mut LayoutTree, overflowing: f32, xAxis: bool) {
    var overflow = overflowing;
    while (overflow < -EPSILON && l.scratch.length() > 0) {
        var totalWeight: f32 = 0.0;
        for (k in 0..l.scratch.length()) {
            totalWeight += sizeOf(l, l.scratch.items[k], xAxis);
        }
        if (totalWeight <= EPSILON) {
            break;
        }
        let remaining = overflow;
        let before = overflow;
        var k: usize = 0;
        while (k < l.scratch.length()) {
            let child = l.scratch.items[k];
            let minSize = minOf(l, child, xAxis);
            let previous = sizeOf(l, child, xAxis);
            let size = (previous + remaining * (previous / totalWeight)).max(minSize);
            setSize(mut l, child, xAxis, size);
            overflow -= size - previous;
            if (size <= minSize + EPSILON) {
                removeSwapback(mut l, k);
            } else {
                k += 1;
            }
        }
        if (overflow - before < EPSILON) {
            break;
        }
    }
}

/// Clay__SizeContainersAlongAxis for one axis, over every tree root. Text and aspect-ratio elements met on the
/// x pass are collected by the caller from `collectSizingTargets`.
fn sizeContainersAlongAxis(l: borrow mut LayoutTree, xAxis: bool) {
    for (rootIndex in 0..l.roots.length()) {
        let root = l.roots.items[rootIndex];
        let rootElement = root.index;
        let decl = l.nodes.items[rootElement].decl;
        // Size floating containers to their parents.
        if (decl.floating.isFloating()) {
            match (root.parentIndex) {
                Some(p) => {
                    let parentDims = l.nodes.items[p].dims;
                    if (decl.layout.width.isGrow()) {
                        l.nodes.items[rootElement].dims.w = parentDims.w;
                    } else if (decl.layout.width.isPercent()) {
                        l.nodes.items[rootElement].dims.w = parentDims.w * decl.layout.width.percent;
                    }
                    if (decl.layout.height.isGrow()) {
                        l.nodes.items[rootElement].dims.h = parentDims.h;
                    } else if (decl.layout.height.isPercent()) {
                        l.nodes.items[rootElement].dims.h = parentDims.h * decl.layout.height.percent;
                    }
                }
                null => {}
            }
        }
        let w = l.nodes.items[rootElement].decl.layout.width;
        let h = l.nodes.items[rootElement].decl.layout.height;
        if (!w.isPercent()) {
            l.nodes.items[rootElement].dims.w = l.nodes.items[rootElement].dims.w.max(w.min).min(w.max);
        }
        if (!h.isPercent()) {
            l.nodes.items[rootElement].dims.h = l.nodes.items[rootElement].dims.h.max(h.min).min(h.max);
        }
        sizeChildren(mut l, rootElement, xAxis);
    }
}

/// The per-parent body of Clay__SizeContainersAlongAxis, applied parent-first down the tree (Clay's BFS order
/// within a root; any parent-before-child order gives the same result, since a parent's pass only reads its own
/// size and writes its children's).
fn sizeChildren(l: borrow mut LayoutTree, parent: usize, xAxis: bool) {
    let p = l.nodes.items[parent];
    if (p.isText || p.childCount == 0) {
        return;
    }
    sizeOneParent(mut l, parent, xAxis);
    for (k in 0..p.childCount) {
        let child = childOf(l, parent, k);
        if (!l.nodes.items[child].isText && l.nodes.items[child].childCount > 0) {
            sizeChildren(mut l, child, xAxis);
        }
    }
}

fn sizeOneParent(l: borrow mut LayoutTree, parent: usize, xAxis: bool) {
    let p = l.nodes.items[parent];
    let layout = p.decl.layout;
    let parentSize = if (xAxis) p.dims.w else p.dims.h;
    let parentPadding =
        if (xAxis) layout.padding.left + layout.padding.right else layout.padding.top + layout.padding.bottom;
    let sizingAlongAxis = (xAxis && layout.isRow()) || (!xAxis && !layout.isRow());
    let clipsThisAxis = (xAxis && p.decl.clip.horizontal) || (!xAxis && p.decl.clip.vertical);
    var innerContentSize: f32 = 0.0;
    var totalPaddingAndChildGaps = parentPadding;
    var growContainerCount: usize = 0;
    var first = true;
    var cssFlex = false;
    l.scratch.clear();

    for (k in 0..p.childCount) {
        let child = childOf(l, parent, k);
        let c = l.nodes.items[child];
        let sizing = sizingOf(l, child, xAxis);
        let childSize = if (xAxis) c.dims.w else c.dims.h;
        let m = marginOf(l, child);
        let axisMargin = if (xAxis) m.left + m.right else m.top + m.bottom;
        if (!c.isText && c.decl.layout.basis > 0.0) {
            cssFlex = true;
        }
        if (!sizing.isPercent() && !sizing.isFixed() && (!c.isText || c.text.wrapsWords())) {
            l.scratch.push(child);
        }
        if (sizingAlongAxis) {
            innerContentSize += if (sizing.isPercent()) 0.0 else childSize;
            innerContentSize += axisMargin;
            totalPaddingAndChildGaps += axisMargin;
            if (sizing.isGrow()) {
                growContainerCount += 1;
            }
            if (!first) {
                innerContentSize += layout.childGap;
                totalPaddingAndChildGaps += layout.childGap;
            }
        } else {
            innerContentSize = (childSize + axisMargin).max(innerContentSize);
        }
        first = false;
    }

    // Expand percentage containers to size.
    for (k in 0..p.childCount) {
        let child = childOf(l, parent, k);
        let sizing = sizingOf(l, child, xAxis);
        if (sizing.isPercent()) {
            let percentBase =
                if (sizingAlongAxis &&
                    layout.wrap) parentSize - parentPadding else parentSize - totalPaddingAndChildGaps;
            let size = percentBase * sizing.percent;
            setSize(mut l, child, xAxis, size);
            if (sizingAlongAxis) {
                innerContentSize += size;
            }
            updateAspectRatioBox(mut l, child);
        }
    }

    if (sizingAlongAxis && layout.wrap) {
        // Overflowing children move to the next line; GROW children share their own line's free space.
        var start: usize = 0;
        while (start < p.childCount) {
            let line = nextWrapLine(l, parent, start, false);
            l.scratch.clear();
            for (i in start..line.end) {
                let child = childOf(l, parent, i);
                if (sizingOf(l, child, xAxis).isGrow()) {
                    l.scratch.push(child);
                }
            }
            growAdditive(mut l, parentSize - parentPadding - line.mainSize, xAxis);
            start = line.end;
        }
    } else if (sizingAlongAxis) {
        var sizeToDistribute = parentSize - parentPadding - innerContentSize;
        if (sizeToDistribute < 0.0) {
            // A clipping parent leaves its overflowing children alone.
            if (clipsThisAxis) {
                return;
            }
            // shrink-0 children keep their base size.
            var k: usize = 0;
            while (k < l.scratch.length()) {
                let child = l.scratch.items[k];
                if (!l.nodes.items[child].isText && l.nodes.items[child].decl.layout.noShrink) {
                    removeSwapback(mut l, k);
                } else {
                    k += 1;
                }
            }
            if (cssFlex) {
                shrinkWeighted(mut l, sizeToDistribute, xAxis);
                l.scratch.clear();
            }
            // Clay's compression: shrink the largest children toward the second largest, repeatedly.
            while (sizeToDistribute < -EPSILON && l.scratch.length() > 0) {
                var largest: f32 = 0.0;
                var secondLargest: f32 = 0.0;
                var widthToAdd = sizeToDistribute;
                for (j in 0..l.scratch.length()) {
                    let size = sizeOf(l, l.scratch.items[j], xAxis);
                    if (floatEqual(size, largest)) {
                        continue;
                    }
                    if (size > largest) {
                        secondLargest = largest;
                        largest = size;
                    }
                    if (size < largest) {
                        secondLargest = secondLargest.max(size);
                        widthToAdd = secondLargest - largest;
                    }
                }
                widthToAdd = widthToAdd.max(sizeToDistribute / usizeF(l.scratch.length()));
                var j: usize = 0;
                while (j < l.scratch.length()) {
                    let child = l.scratch.items[j];
                    let previous = sizeOf(l, child, xAxis);
                    var removed = false;
                    if (floatEqual(previous, largest)) {
                        var size = previous + widthToAdd;
                        let minSize = minOf(l, child, xAxis);
                        if (size <= minSize) {
                            size = minSize;
                            removed = true;
                        }
                        setSize(mut l, child, xAxis, size);
                        sizeToDistribute -= size - previous;
                    }
                    if (removed) {
                        removeSwapback(mut l, j);
                    } else {
                        j += 1;
                    }
                }
            }
        } else if (sizeToDistribute > 0.0 && growContainerCount > 0) {
            var k: usize = 0;
            while (k < l.scratch.length()) {
                if (!sizingOf(l, l.scratch.items[k], xAxis).isGrow()) {
                    removeSwapback(mut l, k);
                } else {
                    k += 1;
                }
            }
            if (cssFlex) {
                growAdditive(mut l, sizeToDistribute, xAxis);
                l.scratch.clear();
            }
            // Clay's expansion: grow the smallest children toward the second smallest, repeatedly.
            while (sizeToDistribute > EPSILON && l.scratch.length() > 0) {
                var smallest = MAX_FLOAT;
                var secondSmallest = MAX_FLOAT;
                var widthToAdd = sizeToDistribute;
                for (j in 0..l.scratch.length()) {
                    let size = sizeOf(l, l.scratch.items[j], xAxis);
                    if (floatEqual(size, smallest)) {
                        continue;
                    }
                    if (size < smallest) {
                        secondSmallest = smallest;
                        smallest = size;
                    }
                    if (size > smallest) {
                        secondSmallest = secondSmallest.min(size);
                        widthToAdd = secondSmallest - smallest;
                    }
                }
                widthToAdd = widthToAdd.min(sizeToDistribute / usizeF(l.scratch.length()));
                var j: usize = 0;
                while (j < l.scratch.length()) {
                    let child = l.scratch.items[j];
                    let previous = sizeOf(l, child, xAxis);
                    var removed = false;
                    if (floatEqual(previous, smallest)) {
                        var size = previous + widthToAdd;
                        let maxSize = sizingOf(l, child, xAxis).max;
                        if (size >= maxSize) {
                            size = maxSize;
                            removed = true;
                        }
                        setSize(mut l, child, xAxis, size);
                        sizeToDistribute -= size - previous;
                    }
                    if (removed) {
                        removeSwapback(mut l, j);
                    } else {
                        j += 1;
                    }
                }
            }
        }
    } else if (layout.wrap) {
        // Off-axis GROW / items-stretch children fill their LINE's cross size.
        let hinted = xAxis;
        let lineStretch = match (layout.alignContent) {
            AlignContent.Stretch => measureWrapLines(l, parent, hinted).stretch,
            _ => 0.0,
        };
        l.nodes.items[parent].wrapLineStretch = lineStretch;
        if (xAxis) {
            l.nodes.items[parent].wrapLineSignature = wrapLineSignature(l, parent, true);
        }
        var start: usize = 0;
        while (start < p.childCount) {
            let line = nextWrapLine(l, parent, start, hinted);
            let lineCross = line.crossSize + lineStretch;
            for (i in start..line.end) {
                let child = childOf(l, parent, i);
                if (l.nodes.items[child].isText) {
                    continue;
                }
                let sizing = sizingOf(l, child, xAxis);
                if (sizing.isGrow() || (layout.stretch && sizing.isFit())) {
                    let m = marginOf(l, child);
                    let target = lineCross - (if (xAxis) m.left + m.right else m.top + m.bottom);
                    let size = minOf(l, child, xAxis).max(target.min(sizing.max));
                    setSize(mut l, child, xAxis, size);
                }
            }
            start = line.end;
        }
    } else {
        // Sizing along the non-layout ("off") axis.
        for (k in 0..l.scratch.length()) {
            let child = l.scratch.items[k];
            let sizing = sizingOf(l, child, xAxis);
            let minSize = minOf(l, child, xAxis);
            let m = marginOf(l, child);
            let offAxisMargin = if (xAxis) m.left + m.right else m.top + m.bottom;
            var maxSize = parentSize - parentPadding - offAxisMargin;
            // Children of a scroll panel grow to its content, not its outer size.
            if (clipsThisAxis) {
                maxSize = maxSize.max(innerContentSize);
            }
            var size = sizeOf(l, child, xAxis);
            if (sizing.isGrow()) {
                size = maxSize.min(sizing.max);
            } else if (layout.stretch && sizing.isFit()) {
                size = if (sizing.max > 0.0) maxSize.min(sizing.max) else maxSize;
            }
            let clamped = minSize.max(size.min(maxSize));
            setSize(mut l, child, xAxis, clamped);
        }
    }
}
