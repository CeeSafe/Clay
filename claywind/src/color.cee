// SPDX-License-Identifier: MIT
// Color type and the full Tailwind palette, generated from ClayWind's renderer.h (243 colors + extras).
// Palette entries are packed 0xRRGGBBAA `u32` constants: CeeSafe has no struct constants yet (Phase 0, N0216).

/// An 8-bit straight-alpha RGBA color.
public struct Color {
    public r: u8;
    public g: u8;
    public b: u8;
    public a: u8;

    public fn rgb(r: u8, g: u8, b: u8) -> Color => Color { r: r, g: g, b: b, a: 255 };
    public fn rgba(r: u8, g: u8, b: u8, a: u8) -> Color => Color { r: r, g: g, b: b, a: a };

    /// Unpacks a 0xRRGGBBAA value, the form the palette constants take.
    public fn hex(v: u32) -> Color => Color {
        r: truncate<u8>(v >> 24),
        g: truncate<u8>(v >> 16),
        b: truncate<u8>(v >> 8),
        a: truncate<u8>(v),
    };

    /// Packs back to 0xRRGGBBAA.
    public fn packed(this) -> u32 =>
        ((this.r as u32) << 24) | ((this.g as u32) << 16) | ((this.b as u32) << 8) | (this.a as u32);

    /// Exact equality of all four channels.
    public fn same(this, other: Color) -> bool =>
        this.r == other.r && this.g == other.g && this.b == other.b && this.a == other.a;
}

/// The color with its alpha replaced (C `WITH_ALPHA(color, alpha)`; Tailwind `bg-blue-500/50` is `withAlpha(BLUE_500, 128)`).
public fn withAlpha(color: u32, alpha: u8) -> u32 => (color & 0xFFFFFF00) | (alpha as u32);

/// `dark` when `isDark`, else `light` (C `THEME(dark, light)`; the dark-mode flag lives in the `Ui`, not a global).
public fn theme(isDark: bool, dark: u32, light: u32) -> u32 => if (isDark) dark else light;

