@test
fn powMatchesLibm() -> Result<void, TestFailure> {
    let xs = POW_X;
    let es = POW_E;
    let ys = POW_Y;
    for (i in 0..xs.length) {
        near64("pow", i, f64.fromBits(ys[i]), Math64.pow(f64.fromBits(xs[i]), f64.fromBits(es[i])), 1e-11)?;
    }
    return Ok();
}

@test
fn specialValues() -> Result<void, TestFailure> {
    Check.isTrue(Math64.ln(0.0) < -1e308, "ln 0 is -inf")?;
    let nan = Math64.ln(-1.0);
    Check.isTrue(nan != nan, "ln of a negative is NaN")?;
    Check.isTrue(Math64.exp(800.0) > 1e308, "exp overflows to +inf")?;
    Check.isTrue(Math64.exp(-800.0) == 0.0, "exp underflows to 0")?;
    Check.isTrue(Math64.pow(0.0, 2.0) == 0.0, "0^2")?;
    Check.isTrue(Math64.pow(5.0, 0.0) == 1.0, "x^0")?;
    return Ok();
}

@test
fn f32ApiAndHelpers() -> Result<void, TestFailure> {
    near32("sin 30deg", 0.5, Math.sin(Math.radians(30.0)), 1e-6)?;
    near32("cos 60deg", 0.5, Math.cos(Math.radians(60.0)), 1e-6)?;
    near32("degrees", 180.0, Math.degrees(PI), 1e-4)?;
    near32("hypot", 5.0, Math.hypot(3.0, 4.0), 1e-6)?;
    near32("lerp", 7.5, Math.lerp(5.0, 10.0, 0.5), 1e-6)?;
    near32("clamp", 1.0, Math.clamp(3.0, 0.0, 1.0), 0.0)?;
    near32("smoothstep mid", 0.5, Math.smoothstep(0.0, 2.0, 1.0), 1e-6)?;
    near32("round half up", 3.0, Math.round(2.5), 0.0)?;
    near32("round negative", -3.0, Math.round(-2.5), 0.0)?;
    return Ok();
}

@test
fn cssEasingCurves() -> Result<void, TestFailure> {
    let xs = EASE_X;
    let inOut = EASE_IN_OUT;
    let out = EASE_OUT;
    let a = CubicBezier.easeInOut();
    let b = CubicBezier.easeOut();
    for (i in 0..xs.length) {
        let x = round<f32>(f64.fromBits(xs[i]));
        near64("ease-in-out", i, f64.fromBits(inOut[i]), a.at(x) as f64, 1e-5)?;
        near64("ease-out", i, f64.fromBits(out[i]), b.at(x) as f64, 1e-5)?;
    }
    near32("linear", 0.3, CubicBezier.linear().at(0.3), 1e-5)?;
    near32("ends", 1.0, a.at(1.0), 0.0)?;
    return Ok();
}
