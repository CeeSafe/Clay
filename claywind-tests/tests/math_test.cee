// claywind math against an independent libm (reference.cee is generated from Python's math module).

import claywind;

@test
fn sinMatchesLibm() -> Result<void, TestFailure> {
    let xs = SIN_X;
    let ys = SIN_Y;
    for (i in 0..xs.length) {
        near64("sin", i, f64.fromBits(ys[i]), Math64.sin(f64.fromBits(xs[i])), 1e-12)?;
    }
    return Ok();
}

@test
fn cosMatchesLibm() -> Result<void, TestFailure> {
    let xs = SIN_X;
    let ys = COS_Y;
    for (i in 0..xs.length) {
        near64("cos", i, f64.fromBits(ys[i]), Math64.cos(f64.fromBits(xs[i])), 1e-12)?;
    }
