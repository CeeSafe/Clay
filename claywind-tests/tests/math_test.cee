fn atanMatchesLibm() -> Result<void, TestFailure> {
    let xs = ATAN_X;
    let ys = ATAN_Y;
    for (i in 0..xs.length) {
        near64("atan", i, f64.fromBits(ys[i]), Math64.atan(f64.fromBits(xs[i])), 1e-10)?;
