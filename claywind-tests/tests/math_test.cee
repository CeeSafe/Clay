@test
fn atan2CoversEveryQuadrant() -> Result<void, TestFailure> {
    let ys = ATAN2_Y;
    let xs = ATAN2_X;
    let rs = ATAN2_R;
    for (i in 0..ys.length) {
        near64("atan2", i, f64.fromBits(rs[i]), Math64.atan2(f64.fromBits(ys[i]), f64.fromBits(xs[i])), 1e-10)?;
    }
    return Ok();
}

