// Shared test helpers.

/// Within `tolerance` absolutely, or relatively for large magnitudes. Prints the case on failure.
fn near64(what: StringView, index: usize, expected: f64, actual: f64, tolerance: f64) -> Result<void, TestFailure> {
    let scale = if (expected.abs() > 1.0) expected.abs() else 1.0;
    let ok = (actual - expected).abs() <= tolerance * scale || (actual == expected);
    if (!ok) {
        Console.write(what);
        Console.write(" case ");
        Console.write(index);
        Console.write(": expected ");
        Console.write(expected);
        Console.write(", got ");
        Console.writeLine(actual);
        return Check.fail("value outside tolerance");
    }
    return Ok();
}

fn near32(what: StringView, expected: f32, actual: f32, tolerance: f32) -> Result<void, TestFailure> =>
    near64(what, 0, expected as f64, actual as f64, tolerance as f64);
