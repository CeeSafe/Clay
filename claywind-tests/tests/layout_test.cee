// SPDX-License-Identifier: MIT
// The C ClayWind's headless geometry tests (tests/layout_test.c), ported case for case: same trees, same expected
// numbers, same 0.5px tolerance. Transitions (Phase 3) and the framebuffer gradient (Phase 4) are ported with
// those phases.

import claywind;

@test
fn justifySpaceModes() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    // Three 100px boxes in a 600px row: between 0/250/500, around 50/250/450, evenly 75/250/425.
    for (m in 0..3) {
        t.begin(1000.0, 1000.0);
        var row = fixedBox(600.0, 100.0);
        row.layout.alignX = if (m == 0) AxisAlign.Between else if (m == 1) AxisAlign.Around else AxisAlign.Evenly;
        t.open(hashId("jrow"), row);
        leaf(mut t, "j0", fixedBox(100.0, 100.0));
        leaf(mut t, "j1", fixedBox(100.0, 100.0));
        leaf(mut t, "j2", fixedBox(100.0, 100.0));
        t.close();
        finishTree(mut t)?;
        let x0: f32 = if (m == 0) 0.0 else if (m == 1) 50.0 else 75.0;
        let x2: f32 = if (m == 0) 500.0 else if (m == 1) 450.0 else 425.0;
        expect("x0", boxIn(t, "j0").x, x0)?;
        expect("x1", boxIn(t, "j1").x, 250.0)?;
        expect("x2", boxIn(t, "j2").x, x2)?;
    }
    return Ok();
}

@test
fn reverseRowAndColumn() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var row = fixedBox(500.0, 100.0);
    row.layout.childGap = 20.0;
    row.layout.reverse = true;
    t.open(hashId("rrow"), row);
    leaf(mut t, "r0", fixedBox(100.0, 100.0));
    leaf(mut t, "r1", fixedBox(100.0, 100.0));
    leaf(mut t, "r2", fixedBox(100.0, 100.0));
    t.close();
    var col = column(SizingAxis.fixed(100.0), SizingAxis.fixed(300.0));
    col.layout.childGap = 10.0;
    col.layout.reverse = true;
    t.open(hashId("rcol"), col);
    leaf(mut t, "c0", fixedBox(100.0, 50.0));
    leaf(mut t, "c1", fixedBox(100.0, 50.0));
    leaf(mut t, "c2", fixedBox(100.0, 50.0));
    t.close();
    finishTree(mut t)?;
    expect("r2 x (first slot)", boxIn(t, "r2").x, 0.0)?;
    expect("r1 x (middle)", boxIn(t, "r1").x, 120.0)?;
    expect("r0 x (last slot)", boxIn(t, "r0").x, 240.0)?;
    let top = boxIn(t, "rcol").y;
    expect("c2 y (first slot)", boxIn(t, "c2").y - top, 0.0)?;
    expect("c1 y (middle)", boxIn(t, "c1").y - top, 60.0)?;
    expect("c0 y (last slot)", boxIn(t, "c0").y - top, 120.0)?;
    return Ok();
}

@test
fn defaultRowAndStretch() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var row = fixedBox(500.0, 100.0);
    row.layout.childGap = 20.0;
    t.open(hashId("brow"), row);
    leaf(mut t, "b0", fixedBox(100.0, 100.0));
    leaf(mut t, "b1", fixedBox(100.0, 100.0));
    t.close();
    finishTree(mut t)?;
    expect("b0 x", boxIn(t, "b0").x, 0.0)?;
    expect("b1 x", boxIn(t, "b1").x, 120.0)?;

    t.begin(1000.0, 1000.0);
    var srow = fixedBox(400.0, 200.0);
    srow.layout.stretch = true;
    t.open(hashId("srow"), srow);
    leaf(mut t, "s_fit", sized(SizingAxis.fixed(100.0), SizingAxis.fit()));
    leaf(mut t, "s_fixed", fixedBox(100.0, 60.0));
    t.close();
    finishTree(mut t)?;
    expect("fit child stretched h", boxIn(t, "s_fit").h, 200.0)?;
    expect("fixed child kept h", boxIn(t, "s_fixed").h, 60.0)?;
    return Ok();
}

@test
fn marginsShiftAndShrinkGrowSpace() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("mrow"), fixedBox(500.0, 100.0));
    var a = fixedBox(100.0, 100.0);
    a.layout.margin.left = 10.0;
    a.layout.margin.right = 5.0;
    leaf(mut t, "ma", a);
    var b = fixedBox(100.0, 100.0);
    b.layout.margin.left = 20.0;
    leaf(mut t, "mb", b);
    leaf(mut t, "mg", sized(SizingAxis.grow(), SizingAxis.fixed(100.0)));
    t.close();
    finishTree(mut t)?;
    expect("a x (left margin)", boxIn(t, "ma").x, 10.0)?;
    expect("b x", boxIn(t, "mb").x, 135.0)?;
    expect("grow x", boxIn(t, "mg").x, 235.0)?;
    expect("grow width", boxIn(t, "mg").w, 265.0)?;

    t.begin(1000.0, 1000.0);
    t.open(hashId("mc"), column(SizingAxis.fixed(200.0), SizingAxis.fixed(300.0)));
    var c0 = fixedBox(50.0, 50.0);
    c0.layout.margin.top = 10.0;
    c0.layout.margin.left = 30.0;
    leaf(mut t, "mc0", c0);
    var c1 = fixedBox(50.0, 50.0);
    c1.layout.margin.top = -20.0;
    leaf(mut t, "mc1", c1);
    t.close();
    finishTree(mut t)?;
    let top = boxIn(t, "mc").y;
    expect("c0 y (top margin)", boxIn(t, "mc0").y - top, 10.0)?;
    expect("c0 x (left margin)", boxIn(t, "mc0").x, 30.0)?;
    expect("c1 y (negative margin pulls up)", boxIn(t, "mc1").y - top, 40.0)?;
    return Ok();
}

@test
fn translateIsVisualOnly() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("trow"), fixedBox(500.0, 100.0));
    var a = fixedBox(100.0, 100.0);
    a.layout.translate = Vec2 { x: 15.0, y: 5.0 };
    t.open(hashId("t_a"), a);
    leaf(mut t, "t_child", fixedBox(20.0, 20.0));
    t.close();
    leaf(mut t, "t_b", fixedBox(100.0, 100.0));
    t.close();
    finishTree(mut t)?;
    expect("a x shifted", boxIn(t, "t_a").x, 15.0)?;
    expect("a y shifted", boxIn(t, "t_a").y, 5.0)?;
    expect("child inherits shift x", boxIn(t, "t_child").x, 15.0)?;
    expect("child inherits shift y", boxIn(t, "t_child").y, 5.0)?;
    expect("sibling b unaffected", boxIn(t, "t_b").x, 100.0)?;
    return Ok();
}

@test
fn flexWrapBasics() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var w = sized(SizingAxis.fixed(250.0), SizingAxis.fit());
    w.layout.childGap = 10.0;
    w.layout.childGapCross = 20.0;
    w.layout.wrap = true;
    t.open(hashId("wrapc"), w);
    leaf(mut t, "w0", fixedBox(100.0, 30.0));
    leaf(mut t, "w1", fixedBox(100.0, 30.0));
    leaf(mut t, "w2", fixedBox(100.0, 30.0));
    leaf(mut t, "w3", fixedBox(100.0, 30.0));
    t.close();
    finishTree(mut t)?;
    expect("w0 x", boxIn(t, "w0").x, 0.0)?;
    expect("w0 y", boxIn(t, "w0").y, 0.0)?;
    expect("w1 x", boxIn(t, "w1").x, 110.0)?;
    expect("w1 y", boxIn(t, "w1").y, 0.0)?;
    expect("w2 x", boxIn(t, "w2").x, 0.0)?;
    expect("w2 y", boxIn(t, "w2").y, 50.0)?;
    expect("w3 x", boxIn(t, "w3").x, 110.0)?;
    expect("w3 y", boxIn(t, "w3").y, 50.0)?;
    expect("container height", boxIn(t, "wrapc").h, 80.0)?;
    return Ok();
}

@test
fn flexWrapJustifyPerLine() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    for (m in 0..3) {
        t.begin(1000.0, 1000.0);
        var w = sized(SizingAxis.fixed(250.0), SizingAxis.fit());
        w.layout.childGap = 10.0;
        w.layout.wrap = true;
        w.layout.alignX = if (m == 0) AxisAlign.Center else if (m == 1) AxisAlign.Between else AxisAlign.End;
        t.open(hashId("wj"), w);
        leaf(mut t, "wj0", fixedBox(100.0, 30.0));
        leaf(mut t, "wj1", fixedBox(100.0, 30.0));
        leaf(mut t, "wj2", fixedBox(100.0, 30.0));
        t.close();
        finishTree(mut t)?;
        let want0: f32 = if (m == 0) 20.0 else if (m == 1) 0.0 else 40.0;
        let want1: f32 = if (m == 0) 130.0 else 150.0;
        let want2: f32 = if (m == 0) 75.0 else if (m == 1) 0.0 else 150.0;
        expect("wj0 x", boxIn(t, "wj0").x, want0)?;
        expect("wj1 x", boxIn(t, "wj1").x, want1)?;
        expect("wj2 x (line 2)", boxIn(t, "wj2").x, want2)?;
    }
    return Ok();
}

@test
fn flexWrapCrossAlignWithinLine() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    for (m in 0..2) {
        t.begin(1000.0, 1000.0);
        var w = fixedBox(250.0, 300.0);
        w.layout.childGap = 10.0;
        w.layout.childGapCross = 5.0;
        w.layout.wrap = true;
        w.layout.alignY = if (m == 0) AxisAlign.Center else AxisAlign.End;
        t.open(hashId("wa"), w);
        leaf(mut t, "wa0", fixedBox(100.0, 30.0));
        leaf(mut t, "wa1", fixedBox(100.0, 50.0));
        leaf(mut t, "wa2", fixedBox(100.0, 20.0));
        t.close();
        finishTree(mut t)?;
        expect("wa0 y", boxIn(t, "wa0").y, if (m == 0) 10.0 else 20.0)?;
        expect("wa1 y", boxIn(t, "wa1").y, 0.0)?;
        expect("wa2 y (line 2)", boxIn(t, "wa2").y, 55.0)?;
    }
    return Ok();
}

@test
fn flexWrapReverseAndMargins() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var w = sized(SizingAxis.fixed(250.0), SizingAxis.fit());
    w.layout.childGap = 10.0;
    w.layout.wrap = true;
    w.layout.reverse = true;
    t.open(hashId("wr"), w);
    leaf(mut t, "wr0", fixedBox(100.0, 30.0));
    leaf(mut t, "wr1", fixedBox(100.0, 30.0));
    leaf(mut t, "wr2", fixedBox(100.0, 30.0));
    t.close();
    finishTree(mut t)?;
    expect("reverse wr1 x", boxIn(t, "wr1").x, 0.0)?;
    expect("reverse wr0 x", boxIn(t, "wr0").x, 110.0)?;
    expect("reverse wr2 x", boxIn(t, "wr2").x, 0.0)?;
    expect("reverse wr2 y", boxIn(t, "wr2").y, 30.0)?;

    t.begin(1000.0, 1000.0);
    var wm = sized(SizingAxis.fixed(250.0), SizingAxis.fit());
    wm.layout.wrap = true;
    t.open(hashId("wm"), wm);
    var m0 = fixedBox(100.0, 30.0);
    m0.layout.margin = Sides { top: 5.0, right: 10.0, bottom: 0.0, left: 10.0 };
    leaf(mut t, "wm0", m0);
    var m1 = fixedBox(100.0, 30.0);
    m1.layout.margin = Sides { top: 0.0, right: 10.0, bottom: 0.0, left: 10.0 };
    leaf(mut t, "wm1", m1);
    leaf(mut t, "wm2", m1);
    t.close();
    finishTree(mut t)?;
    expect("margin wm0 x", boxIn(t, "wm0").x, 10.0)?;
    expect("margin wm0 y", boxIn(t, "wm0").y, 5.0)?;
    expect("margin wm1 x", boxIn(t, "wm1").x, 130.0)?;
    expect("margin wm2 x (wrapped)", boxIn(t, "wm2").x, 10.0)?;
    expect("margin wm2 y", boxIn(t, "wm2").y, 35.0)?;
    expect("margin container h", boxIn(t, "wm").h, 65.0)?;
    return Ok();
}

@test
fn flexWrapColumn() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
