}

@test
fn flexWrapNotSqueezed() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("sq"), column(SizingAxis.fixed(300.0), SizingAxis.fixed(100.0)));
    var c = column(SizingAxis.grow(), SizingAxis.fit());
    c.layout.childGap = 8.0;
    c.layout.wrap = true;
    t.open(hashId("sq_col"), c);
    leaf(mut t, "sq0", fixedBox(60.0, 26.0));
    leaf(mut t, "sq1", fixedBox(60.0, 26.0));
    leaf(mut t, "sq2", fixedBox(60.0, 26.0));
    t.close();
    leaf(mut t, "sq_more", fixedBox(10.0, 80.0));
    t.close();
    finishTree(mut t)?;
    expect("column keeps its full height", boxIn(t, "sq_col").h, 94.0)?;
    expect("children stay in one column", boxIn(t, "sq2").x, boxIn(t, "sq0").x)?;
    expect("sq2 below sq1", boxIn(t, "sq2").y, 68.0)?;

    t.begin(1000.0, 1000.0);
    t.open(hashId("rq"), column(SizingAxis.fixed(250.0), SizingAxis.fixed(60.0)));
    var r = sized(SizingAxis.grow(), SizingAxis.fit());
    r.layout.childGap = 10.0;
    r.layout.childGapCross = 10.0;
    r.layout.wrap = true;
    t.open(hashId("rq_row"), r);
    leaf(mut t, "rq0", fixedBox(100.0, 26.0));
    leaf(mut t, "rq1", fixedBox(100.0, 26.0));
    leaf(mut t, "rq2", fixedBox(100.0, 26.0));
    t.close();
    leaf(mut t, "rq_after", fixedBox(10.0, 40.0));
    t.close();
    finishTree(mut t)?;
    expect("row keeps 2 lines of height", boxIn(t, "rq_row").h, 62.0)?;
    expect("next sibling below both lines", boxIn(t, "rq_after").y, 62.0)?;
    return Ok();
}

@test
fn flexWrapSizing() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var g = fixedBox(250.0, 200.0);
    g.layout.childGap = 10.0;
    g.layout.wrap = true;
    t.open(hashId("wg"), g);
    leaf(mut t, "wg0", fixedBox(100.0, 40.0));
    leaf(mut t, "wg1", sized(SizingAxis.fixed(100.0), SizingAxis.grow()));
    leaf(mut t, "wg2", sized(SizingAxis.growBetween(60.0, 0.0), SizingAxis.fixed(30.0)));
    t.close();
    finishTree(mut t)?;
    expect("off-axis grow = line height", boxIn(t, "wg1").h, 40.0)?;
    expect("grow child wraps to line 2", boxIn(t, "wg2").y, 40.0)?;
    expect("grow child fills its line", boxIn(t, "wg2").w, 250.0)?;

    t.begin(1000.0, 1000.0);
    t.open(hashId("wp"), sized(SizingAxis.fixed(250.0), SizingAxis.fit()));
    var f = sized(SizingAxis.fit(), SizingAxis.fit());
    f.layout.wrap = true;
    t.open(hashId("wf"), f);
    leaf(mut t, "wf0", fixedBox(100.0, 30.0));
    leaf(mut t, "wf1", fixedBox(100.0, 30.0));
    leaf(mut t, "wf2", fixedBox(100.0, 30.0));
    t.close();
    t.close();
    finishTree(mut t)?;
    expect("fit wrap compressed to parent", boxIn(t, "wf").w, 250.0)?;
    expect("fit wrap: wf2 on line 2", boxIn(t, "wf2").y, 30.0)?;
    expect("fit wrap height (2 lines)", boxIn(t, "wf").h, 60.0)?;
    return Ok();
}

@test
fn alignContentModes() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    // start, center, end, between, around, evenly, stretch: y of line 1 and line 2.
    let want1 = [0, 650, 1300, 0, 325, 433, 0];
    let want2 = [400, 1050, 1700, 1700, 1375, 1267, 1050];
    for (m in 0..7usize) {
        t.begin(1000.0, 1000.0);
        var a = fixedBox(250.0, 200.0);
        a.layout.childGap = 10.0;
        a.layout.childGapCross = 10.0;
        a.layout.wrap = true;
        a.layout.alignContent = match (m) {
            0 => AlignContent.Start,
            1 => AlignContent.Center,
            2 => AlignContent.End,
            3 => AlignContent.Between,
            4 => AlignContent.Around,
            5 => AlignContent.Evenly,
            _ => AlignContent.Stretch,
        };
        t.open(hashId("ac"), a);
        leaf(mut t, "ac0", fixedBox(100.0, 30.0));
        leaf(mut t, "ac1", sized(SizingAxis.fixed(100.0), SizingAxis.grow()));
        leaf(mut t, "ac2", fixedBox(100.0, 30.0));
        t.close();
        finishTree(mut t)?;
        expect("line 1 y", boxIn(t, "ac0").y, round<f32>(want1[m]) / 10.0)?;
        expect("line 2 y", boxIn(t, "ac2").y, round<f32>(want2[m]) / 10.0)?;
    }
    expect("stretch: grow child fills grown line", boxIn(t, "ac1").h, 95.0)?;

    t.begin(1000.0, 1000.0);
    var o = fixedBox(250.0, 50.0);
    o.layout.childGap = 10.0;
    o.layout.childGapCross = 10.0;
    o.layout.wrap = true;
    o.layout.alignContent = AlignContent.Evenly;
    t.open(hashId("ao"), o);
    leaf(mut t, "ao0", fixedBox(100.0, 30.0));
    leaf(mut t, "ao1", fixedBox(100.0, 30.0));
    leaf(mut t, "ao2", fixedBox(100.0, 30.0));
    t.close();
    t.setCulling(false);
    finishTree(mut t)?;
    expect("overflow evenly -> centered", boxIn(t, "ao0").y, -10.0)?;

    t.begin(1000.0, 1000.0);
    var c = column(SizingAxis.fixed(200.0), SizingAxis.fixed(100.0));
    c.layout.childGap = 10.0;
    c.layout.wrap = true;
    c.layout.alignContent = AlignContent.Between;
    t.open(hashId("acc"), c);
    leaf(mut t, "acc0", fixedBox(40.0, 40.0));
    leaf(mut t, "acc1", fixedBox(40.0, 40.0));
    leaf(mut t, "acc2", fixedBox(40.0, 40.0));
    t.close();
    finishTree(mut t)?;
    expect("column between: col 1 x", boxIn(t, "acc0").x, 0.0)?;
    expect("column between: col 2 x", boxIn(t, "acc2").x, 160.0)?;
    return Ok();
}

@test
fn relayoutColumnEstimate() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("ra"), sized(SizingAxis.fit(), SizingAxis.fit()));
    var c = column(SizingAxis.fit(), SizingAxis.fixed(100.0));
    c.layout.childGap = 10.0;
    c.layout.childGapCross = 20.0;
    c.layout.wrap = true;
    t.open(hashId("ra_col"), c);
    leaf(mut t, "ra0", fixedBox(40.0, 40.0));
    leaf(mut t, "ra1", fixedBox(40.0, 40.0));
    leaf(mut t, "ra2", fixedBox(40.0, 40.0));
    t.close();
    leaf(mut t, "ra_next", fixedBox(30.0, 30.0));
    t.close();
    finishTree(mut t)?;
    expect("column width = 2 columns + gap", boxIn(t, "ra_col").w, 100.0)?;
    expect("sibling placed after the columns", boxIn(t, "ra_next").x, 100.0)?;
    expect("parent row fits both", boxIn(t, "ra").w, 130.0)?;
    return Ok();
}

@test
fn relayoutGrowColumn() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("rb"), fixedBox(400.0, 100.0));
    var c = column(SizingAxis.fit(), SizingAxis.grow());
    c.layout.childGap = 10.0;
    c.layout.wrap = true;
    t.open(hashId("rb_col"), c);
    leaf(mut t, "rb0", fixedBox(40.0, 40.0));
    leaf(mut t, "rb1", fixedBox(40.0, 40.0));
    leaf(mut t, "rb2", fixedBox(40.0, 40.0));
    t.close();
    leaf(mut t, "rb_next", fixedBox(30.0, 30.0));
    t.close();
    finishTree(mut t)?;
    expect("grown column height", boxIn(t, "rb_col").h, 100.0)?;
    expect("rb2 in column 2", boxIn(t, "rb2").x, 40.0)?;
    expect("column widened to 2 columns", boxIn(t, "rb_col").w, 80.0)?;
    expect("sibling after the widened column", boxIn(t, "rb_next").x, 80.0)?;
    return Ok();
}

@test
fn relayoutColumnCrossGrow() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var c = column(SizingAxis.fit(), SizingAxis.fixed(100.0));
    c.layout.childGap = 10.0;
    c.layout.wrap = true;
    t.open(hashId("rc"), c);
    leaf(mut t, "rc0", fixedBox(60.0, 40.0));
    leaf(mut t, "rc1", sized(SizingAxis.grow(), SizingAxis.fixed(40.0)));
    leaf(mut t, "rc2", fixedBox(90.0, 40.0));
    t.close();
    finishTree(mut t)?;
    expect("grow child = its column's width", boxIn(t, "rc1").w, 60.0)?;
    expect("column 2 x", boxIn(t, "rc2").x, 60.0)?;
    expect("container = both columns", boxIn(t, "rc").w, 150.0)?;
    return Ok();
}

@test
fn relayoutTextHeights() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("rt"), sized(SizingAxis.fit(), SizingAxis.fit()));
    var c = column(SizingAxis.fit(), SizingAxis.fixed(100.0));
    c.layout.childGap = 10.0;
    c.layout.wrap = true;
    t.open(hashId("rt_col"), c);
    t.open(hashId("rt0"), sized(SizingAxis.fixed(20.0), SizingAxis.fit()));
    text16(mut t, "aa aa aa aa");
    t.close();
    leaf(mut t, "rt1", fixedBox(20.0, 40.0));
    t.close();
    leaf(mut t, "rt_next", fixedBox(30.0, 30.0));
    t.close();
    finishTree(mut t)?;
    expect("wrapped text height", boxIn(t, "rt0").h, 64.0)?;
    expect("rt1 moved to column 2", boxIn(t, "rt1").x, 20.0)?;
    expect("rt1 at top of column 2", boxIn(t, "rt1").y, 0.0)?;
    expect("column width = 2 columns", boxIn(t, "rt_col").w, 40.0)?;
    expect("sibling after both columns", boxIn(t, "rt_next").x, 40.0)?;
    return Ok();
}

@test
fn relayoutAspect() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("rs"), fixedBox(400.0, 100.0));
    var a = sized(SizingAxis.grow(), SizingAxis.grow());
    a.aspectRatio = 1.0;
    leaf(mut t, "rs_box", a);
    leaf(mut t, "rs_next", sized(SizingAxis.grow(), SizingAxis.fixed(30.0)));
    t.close();
    finishTree(mut t)?;
    expect("aspect box height (row height)", boxIn(t, "rs_box").h, 100.0)?;
    expect("aspect box width = height", boxIn(t, "rs_box").w, 100.0)?;
    expect("sibling right after the box", boxIn(t, "rs_next").x, 100.0)?;
    expect("grow sibling takes the freed width", boxIn(t, "rs_next").w, 300.0)?;
    return Ok();
}

@test
fn basisAndShrink() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("bs"), fixedBox(200.0, 50.0));
    var b0 = Decl.of();
    b0.layout.basis = 200.0;
    leaf(mut t, "bs0", b0);
    var b1 = Decl.of();
    b1.layout.basis = 100.0;
    leaf(mut t, "bs1", b1);
    t.close();
    finishTree(mut t)?;
    expect("weighted shrink (basis 200)", boxIn(t, "bs0").w, 133.3)?;
    expect("weighted shrink (basis 100)", boxIn(t, "bs1").w, 66.7)?;

    t.begin(1000.0, 1000.0);
    t.open(hashId("bn"), fixedBox(200.0, 50.0));
    var n0 = Decl.of();
    n0.layout.basis = 150.0;
    n0.layout.noShrink = true;
    leaf(mut t, "bn0", n0);
    var n1 = Decl.of();
    n1.layout.basis = 150.0;
    leaf(mut t, "bn1", n1);
    t.close();
    finishTree(mut t)?;
    expect("shrink-0 keeps basis", boxIn(t, "bn0").w, 150.0)?;
    expect("sibling absorbs overflow", boxIn(t, "bn1").w, 50.0)?;

    t.begin(1000.0, 1000.0);
    t.open(hashId("bg"), fixedBox(400.0, 50.0));
    var g0 = Decl.of();
    g0.layout.width = SizingAxis.grow();
    g0.layout.basis = 100.0;
    leaf(mut t, "bg0", g0);
    var g1 = Decl.of();
    g1.layout.width = SizingAxis.grow();
    g1.layout.basis = 200.0;
    leaf(mut t, "bg1", g1);
    t.close();
    finishTree(mut t)?;
    expect("grow from basis 100", boxIn(t, "bg0").w, 150.0)?;
    expect("grow from basis 200", boxIn(t, "bg1").w, 250.0)?;

    t.begin(1000.0, 1000.0);
    t.open(hashId("bc"), column(SizingAxis.fixed(100.0), SizingAxis.fit()));
    var c0 = sized(SizingAxis.fixed(50.0), SizingAxis.fitBetween(0.0, 70.0));
    c0.layout.basis = 120.0;
    leaf(mut t, "bc0", c0);
    leaf(mut t, "bc1", fixedBox(50.0, 10.0));
    t.close();
    finishTree(mut t)?;
    expect("column basis (clamped to max-h)", boxIn(t, "bc0").h, 70.0)?;
    expect("column sums basis", boxIn(t, "bc").h, 80.0)?;

    t.begin(1000.0, 1000.0);
    t.open(hashId("bt"), sized(SizingAxis.fixed(100.0), SizingAxis.fit()));
    var t0 = Decl.of();
    t0.layout.noShrink = true;
    t.open(hashId("bt0"), t0);
    text16(mut t, "aa aa aa");
    t.close();
    t.open(hashId("bt1"), Decl.of());
    text16(mut t, "bb bb bb");
    t.close();
    t.close();
    finishTree(mut t)?;
    expect("shrink-0 text keeps width", boxIn(t, "bt0").w, 80.0)?;
    expect("other child compressed", boxIn(t, "bt1").w, 20.0)?;
    return Ok();
}

@test
fn insetAnchorsViaFloating() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("ip"), fixedBox(200.0, 100.0));
    var br = fixedBox(20.0, 10.0);
    br.floating.attachTo = AttachTo.Parent;
    br.floating.offset = Vec2 { x: -5.0, y: -8.0 };
    br.floating.element = AttachPoint.RightBottom;
    br.floating.parent = AttachPoint.RightBottom;
    leaf(mut t, "ibr", br);
    var tr = fixedBox(20.0, 10.0);
    tr.floating.attachTo = AttachTo.Parent;
    tr.floating.offset = Vec2 { x: 0.0, y: 4.0 };
    tr.floating.element = AttachPoint.RightTop;
    tr.floating.parent = AttachPoint.RightTop;
    leaf(mut t, "itr", tr);
    t.close();
    finishTree(mut t)?;
    expect("bottom-right x (right-5)", boxIn(t, "ibr").x, 175.0)?;
    expect("bottom-right y (bottom-8)", boxIn(t, "ibr").y, 82.0)?;
    expect("top-right x (right-0)", boxIn(t, "itr").x, 180.0)?;
    expect("top-right y (top-4)", boxIn(t, "itr").y, 4.0)?;
    return Ok();
}

@test
fn textSitsAtThePadding() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var p = Decl.of();
    p.layout.padding = Sides { top: 4.0, right: 12.0, bottom: 4.0, left: 12.0 };
    t.open(hashId("tp"), p);
    var big = TextConfig.of(18.0);
    big.letterSpacing = 1.0;
    t.text("layout".bytes(), big);
    t.close();
    var c = column(SizingAxis.fit(), SizingAxis.fit());
    c.layout.padding = Sides { top: 6.0, right: 8.0, bottom: 6.0, left: 8.0 };
    c.layout.childGap = 2.0;
    t.open(hashId("tc"), c);
    var small = TextConfig.of(14.0);
    small.fontId = 4;
    small.letterSpacing = 2.0;
    small.lineHeight = 20.0;
    t.text("one".bytes(), small);
    t.text("two".bytes(), small);
    t.close();
    finishTree(mut t)?;
    var xs = [-1.0f32, -1.0, -1.0];
    var ys = [-1.0f32, -1.0, -1.0];
    var k: usize = 0;
    for (i in 0..t.commandCount()) {
        match (t.command(i)) {
            Command.Text(area, _) => {
                if (k < 3) {
                    xs[k] = area.x;
                    ys[k] = area.y;
                    k += 1;
                }
            }
            _ => {}
        }
    }
    let pb = boxIn(t, "tp");
    let cb = boxIn(t, "tc");
    expect("row box height = text + padding", pb.h, 24.0)?;
    expect("row text x = padding.left", xs[0] - pb.x, 12.0)?;
    expect("row text y = padding.top", ys[0] - pb.y, 4.0)?;
    expect("column text 1 x = padding.left", xs[1] - cb.x, 8.0)?;
    expect("column text 1 y = padding.top + 2", ys[1] - cb.y, 8.0)?;
    expect("column text 2 y = line 1 + gap + 2", ys[2] - cb.y, 30.0)?;
    return Ok();
}

@test
fn lineClampEllipsizes() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    t.open(hashId("clampbox"), sized(SizingAxis.fixed(100.0), SizingAxis.fit()));
    var config = TextConfig.of(16.0);
    config.lineClamp = 2;
    t.text("one two three four five six seven eight nine ten eleven twelve".bytes(), config);
    t.close();
    finishTree(mut t)?;
    expect("clamped to 2 lines (height)", boxIn(t, "clampbox").h, 32.0)?;
    var ellipsis = false;
    for (i in 0..t.commandCount()) {
        match (t.command(i)) {
            Command.Text(_, run) => {
                let s = t.textBytes(run);
                if (s.length >= 3 && s[s.length - 1] == '.' && s[s.length - 2] == '.' && s[s.length - 3] == '.') {
                    ellipsis = true;
                }
            }
            _ => {}
        }
    }
    return Check.isTrue(ellipsis, "last clamped line ends in an ellipsis");
}

@test
fn containerQueriesReadThePreviousFrame() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    Check.isTrue(t.boxOf(hashId("cq_never")) == null, "unknown container is not found")?;
    t.begin(1000.0, 1000.0);
    leaf(mut t, "cq", fixedBox(300.0, 120.0));
    finishTree(mut t)?;
    t.begin(1000.0, 1000.0);
    let previous = boxIn(t, "cq");
    leaf(mut t, "cq", fixedBox(300.0, 120.0));
    finishTree(mut t)?;
    expect("prev-frame width mid-build", previous.w, 300.0)?;
    expect("prev-frame height mid-build", previous.h, 120.0)?;
    return Ok();
}

@test
fn itemsBaseline() -> Result<void, TestFailure> {
    var storage = [0u8; 262144];
    let memory = FixedBufferAllocator.over(mut storage);
    var t = LayoutTree.create(memory, LayoutCapacity.of(64))!;
    t.begin(1000.0, 1000.0);
    var row = fixedBox(400.0, 80.0);
    row.layout.alignY = AxisAlign.Baseline;
    row.layout.childGap = 10.0;
    t.open(hashId("brow"), row);
    var bigText = TextConfig.of(40.0);
    bigText.lineHeight = 40.0;
    var smallText = TextConfig.of(20.0);
    smallText.lineHeight = 20.0;
    t.open(hashId("bl-big"), Decl.of());
    t.text("Big".bytes(), bigText);
    t.close();
    t.open(hashId("bl-small"), Decl.of());
    t.text("small".bytes(), smallText);
    t.close();
    t.close();
    finishTree(mut t)?;
    let row1 = boxIn(t, "brow");
    let big = boxIn(t, "bl-big");
    let small = boxIn(t, "bl-small");
    expect("big box height", big.h, 40.0)?;
    expect("small box height", small.h, 20.0)?;
    expect("big top at row top", big.y - row1.y, 0.0)?;
    expect("small top dropped", small.y - row1.y, 16.0)?;
    expect("baselines aligned", (big.y + 32.0) - (small.y + 16.0), 0.0)?;

    // With a registered metric (0.75 x font size) the drop is 15, not the synthesized 16.
    t.begin(1000.0, 1000.0);
    var mrow = fixedBox(400.0, 80.0);
    mrow.layout.alignY = AxisAlign.Baseline;
    t.open(hashId("mrow"), mrow);
    t.open(hashId("m-big"), Decl.of());
    t.text("Big".bytes(), bigText);
    t.close();
    t.open(hashId("m-small"), Decl.of());
    t.text("small".bytes(), smallText);
    t.close();
    t.close();
    let metric = MetricMeasure { unused: 0 };
    let ended = match (endLayout(mut t, metric)) {
        Ok() => true,
        Err(_) => false,
    };
    Check.isTrue(ended, "frame fits")?;
    let row2 = boxIn(t, "mrow");
    let mbig = boxIn(t, "m-big");
    let msmall = boxIn(t, "m-small");
    expect("metric: big at row top", mbig.y - row2.y, 0.0)?;
    expect("metric: small dropped 15", msmall.y - row2.y, 15.0)?;
    expect("metric: baselines aligned", (mbig.y + 30.0) - (msmall.y + 15.0), 0.0)?;
    return Ok();
}
