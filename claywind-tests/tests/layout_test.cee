    c.layout.childGap = 10.0;
    c.layout.childGapCross = 20.0;
    c.layout.wrap = true;
    t.open(hashId("wc"), c);
    leaf(mut t, "wc0", fixedBox(40.0, 40.0));
    leaf(mut t, "wc1", fixedBox(40.0, 40.0));
    leaf(mut t, "wc2", fixedBox(40.0, 40.0));
    t.close();
    finishTree(mut t)?;
